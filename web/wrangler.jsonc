{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gymori",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Cuenta cuántas fotos se analizan al día (se crea sola en el primer deploy).
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  // IA gratis de Cloudflare para revisar la comida cuando no hay ANTHROPIC_API_KEY.
  "ai": {
    "binding": "AI"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
